# Copy to .env and fill in. Every variable is documented in the README.
# Variables are added here as each feature needs them.

# Port the Express API listens on (default 4000).
PORT=4000

# LLM — any OpenAI-compatible chat endpoint (see docs/DECISIONS.md D5).
# Default: Groq free tier. Create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Two models, because Groq's free limits (8K tokens/min) are per model.
# Strong model: requirement extraction, question generation, gap pass.
LLM_MODEL=openai/gpt-oss-120b
# Fast model: company brief, flashcards (large inputs, easier work).
LLM_MODEL_FAST=openai/gpt-oss-20b

# Web search for public discussion of a company's interview process (D7).
# Optional: without it, only Hacker News search runs. Free key, no card: https://app.tavily.com
TAVILY_API_KEY=

# Allow fetching private/loopback addresses (e.g. http://localhost:8099).
# Defaults to true unless NODE_ENV=production; the deployed API sets it to false (D6).
ALLOW_PRIVATE_URLS=
