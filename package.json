{
  "name": "interview-compass",
  "version": "0.1.0",
  "private": true,
  "description": "Turn a job description into a personalised interview prep kit.",
  "workspaces": [
    "shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev:api": "npm run dev -w @interview-compass/api",
    "dev:web": "npm run dev -w @interview-compass/web",
    "evaluate": "node --env-file-if-exists=.env api/src/cli/evaluate.js",
    "test": "npm test -w @interview-compass/api",
    "lint": "npm run lint -w @interview-compass/web",
    "fixtures": "node api/test/fixtures/server.js"
  }
}
